rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------
    // Rollen-Helfer für den Go-Live.
    // VORAUSSETZUNG: Das users-Dokument eines Mitarbeiters muss als
    // Dokument-ID die Firebase-Auth-UID tragen (siehe Go-Live-Checkliste
    // in docs/projekt-dokumentation.md §5). Solange das nicht der Fall
    // ist, liefert istBuero() false – deshalb sind die schutzbedürftigen
    // Bereiche unten mit "istBuero() || keinRollenmodell()" abgesichert,
    // damit der Betrieb nicht bricht, bevor die UIDs gesetzt sind.
    // ---------------------------------------------------------------
    function angemeldet() {
      return request.auth != null;
    }
    function eigenesProfil() {
      return angemeldet() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function istBuero() {
      return eigenesProfil()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.rolle == 'admin';
    }
    // Übergangsphase: noch kein UID-basiertes Profil vorhanden -> wie bisher
    // jeder Angemeldete. Sobald die UIDs gepflegt sind, greift die Rollenprüfung.
    function keinRollenmodell() {
      return angemeldet() && !eigenesProfil();
    }
    function darfVerwalten() {
      return istBuero() || keinRollenmodell();
    }
    // Greift erst, wenn das UID-Profil existiert – vorher ist niemand "Monteur"
    // und alles läuft über darfVerwalten() weiter wie bisher.
    function istMonteur() {
      return eigenesProfil()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.rolle == 'mitarbeiter';
    }
    // Nur diese Felder wurden angefasst
    function nurFelder(felder) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(felder);
    }
    // Berichte mit diesem Status sind Beweismittel und dürfen sich nicht mehr ändern
    function gesperrterStatus(status) {
      return status == 'freigegeben' || status == 'abgerechnet' || status == 'erstattet';
    }

    // Anfragen von der öffentlichen Gabara-Webseite:
    // Jeder darf ANLEGEN (Formular), aber niemand ohne Login darf lesen/ändern.
    match /requests/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'telefon', 'email', 'anliegen', 'anliegenId', 'nachricht', 'sprache', 'status', 'createdAt', 'datum', 'start', 'dauer'])
                    && request.resource.data.keys().hasAll(['name', 'anliegen', 'status'])
                    && request.resource.data.status == 'neu'
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 1
                    && request.resource.data.name.size() < 120
                    // Optionale Felder erst auf Existenz prüfen – ein fehlendes
                    // 'nachricht' würde die Regel sonst zum Fehler bringen (= Ablehnung).
                    && (!('nachricht' in request.resource.data)
                        || (request.resource.data.nachricht is string && request.resource.data.nachricht.size() < 3000))
                    && (!('email' in request.resource.data)
                        || (request.resource.data.email is string && request.resource.data.email.size() < 200))
                    && (!('telefon' in request.resource.data)
                        || (request.resource.data.telefon is string && request.resource.data.telefon.size() < 60));
      allow read, update, delete: if angemeldet();
    }

    // Belegte Zeitfenster (NUR Datum/Uhrzeit/Status – keine Kundendaten).
    // Wird beim Anlegen/Ändern/Absagen von Terminen gepflegt. Fehlte bisher
    // komplett -> jede Terminanlage wäre im Firebase-Modus an der Catch-all-
    // Regel gescheitert (PERMISSION_DENIED).
    match /slots/{id} {
      allow read: if true;
      allow write: if angemeldet();
    }

    // ---------------------------------------------------------------
    // Interne Kern-Daten. LESEN darf das ganze Team (Kalender, Berichte und
    // Handy-Ansicht brauchen Kunden-, Projekt- und Mitarbeiternamen).
    // SCHREIBEN ist nach Rolle getrennt.
    //
    // Bewusst NICHT eingeschränkt: das Lesen von /projekte auf die zugewiesenen
    // Baustellen. Dafür bräuchte jedes Projekt eine Zuweisungsliste – die gibt
    // es heute nur am Termin (mitarbeiterIds). Vermerkt in der Go-Live-Liste.
    // ---------------------------------------------------------------

    // Kunden: Stammdaten pflegt das Büro (FastBill ist führend).
    match /patients/{id} {
      allow read: if angemeldet();
      allow write: if darfVerwalten();
    }

    // Termine: plant das Büro. Der Monteur darf an SEINEN Einsätzen nur
    // das Häkchen "erledigt" setzen – sonst nichts.
    match /appointments/{id} {
      allow read: if angemeldet();
      allow create, delete: if darfVerwalten();
      allow update: if darfVerwalten()
        || (istMonteur()
            && request.auth.uid in resource.data.get('mitarbeiterIds', [])
            && nurFelder(['erledigt', 'erledigtAm']));
    }

    // Baustellen: legt das Büro an.
    match /projekte/{id} {
      allow read: if angemeldet();
      allow write: if darfVerwalten();
    }

    // Leistungsverzeichnis: Preise und Mengen kommen aus dem Vertrag – nur Büro.
    // Der Monteur meldet ausschließlich die geleistete Menge (Ist).
    match /lvpositionen/{id} {
      allow read: if angemeldet();
      allow create, delete: if darfVerwalten();
      // istQuelle/istAktualisiertAm gehören dazu: Der Monteur meldet über die
      // Sammlung 'leistungen', und derselbe Vorgang schreibt istMenge fort.
      // Ohne diese beiden Schlüssel scheitert die Meldung an nurFelder().
      allow update: if darfVerwalten()
        || (istMonteur() && nurFelder(['istMenge', 'istVon', 'istAm', 'istQuelle', 'istAktualisiertAm']));
    }

    // Regieberichte/Reklamationen/Abnahmen: der Monteur schreibt nur unter
    // seinem eigenen Namen und nur solange der Bericht nicht freigegeben ist.
    // Freigegebene/abgerechnete Berichte sind Beweismittel (§ 15 Abs. 3 VOB/B)
    // und dürfen sich auch für das Büro nicht mehr unbemerkt ändern -> Freigabe
    // erst zurücknehmen, dann bearbeiten.
    match /berichte/{id} {
      allow read: if angemeldet();
      allow create: if darfVerwalten()
        || (istMonteur()
            && request.resource.data.get('mitarbeiterId', '') == request.auth.uid
            && !gesperrterStatus(request.resource.data.get('status', '')));
      allow update: if (darfVerwalten() && !gesperrterStatus(resource.data.get('status', '')))
        || (darfVerwalten() && nurFelder(['status', 'freigegebenAm', 'freigegebenVon']))
        || (istMonteur()
            && resource.data.get('mitarbeiterId', '') == request.auth.uid
            && !gesperrterStatus(resource.data.get('status', ''))
            && !gesperrterStatus(request.resource.data.get('status', '')));
      allow delete: if darfVerwalten();
    }

    // Spesen: gleiche Logik. Den Status auf erstattet setzt nur das Büro.
    match /spesen/{id} {
      allow read: if angemeldet();
      allow create: if darfVerwalten()
        || (istMonteur()
            && request.resource.data.get('mitarbeiterId', '') == request.auth.uid
            && !gesperrterStatus(request.resource.data.get('status', '')));
      allow update: if (darfVerwalten() && !gesperrterStatus(resource.data.get('status', '')))
        || (darfVerwalten() && nurFelder(['status']))
        || (istMonteur()
            && resource.data.get('mitarbeiterId', '') == request.auth.uid
            && !gesperrterStatus(resource.data.get('status', ''))
            && !gesperrterStatus(request.resource.data.get('status', '')));
      allow delete: if darfVerwalten();
    }

    match /photos/{id} {
      // Größencheck NUR bei create/update – bei read/delete existiert
      // request.resource nicht (Zugriff darauf würde alles verweigern).
      allow read: if angemeldet();
      allow create, update: if angemeldet()
        && (!('dataUrl' in request.resource.data) || request.resource.data.dataUrl.size() < 980000);
      // Fremde Baustellen-Fotos löschen darf nur das Büro. Der Monteur darf
      // seine eigenen wieder entfernen (Fehlaufnahme) – erkannt an vonId,
      // NICHT am Anzeigenamen 'von'.
      allow delete: if darfVerwalten()
        || (istMonteur() && resource.data.get('vonId', '') == request.auth.uid);
    }

    // Rechnungen, API-Protokoll, Artikelstamm und Textbausteine: reine Bürodaten.
    match /rechnungen/{id} {
      allow read: if angemeldet();
      allow write: if darfVerwalten();
    }
    match /apilog/{id} {
      // Enthält Aufrufe an FastBill – geht Monteure nichts an
      allow read, write: if darfVerwalten();
    }
    match /katalog/{id} {
      allow read: if angemeldet();
      allow write: if darfVerwalten();
    }
    match /bausteine/{id} {
      allow read: if angemeldet();
      allow write: if darfVerwalten();
    }

    // Mitarbeiterstamm: lesen darf jeder Angemeldete (Namen/Teams stehen in
    // Kalender und Berichten). SCHREIBEN nur das Büro – sonst könnte sich ein
    // Monteur selbst die Rolle 'admin' geben (Rechte-Eskalation).
    match /users/{id} {
      allow read: if angemeldet();
      allow write: if darfVerwalten();
    }

    // Globale Einstellungen. Die Verwaltung liest diese Sammlung als GANZE LISTE
    // (useCollection('settings')). Firestore erlaubt eine Sammlungs-Abfrage nur,
    // wenn die Regel ohne Kenntnis der einzelnen Dokumente erfüllbar ist – eine
    // Bedingung auf die Dokument-ID lässt jede Listen-Abfrage scheitern.
    // Deshalb: get und list getrennt regeln, und NICHTS Geheimes hier ablegen.
    match /settings/{id} {
      // Einzelabruf: die Zeit-Dokumente darf auch die öffentliche Webseite lesen
      allow get: if id in ['pausen', 'oeffnungszeiten'] || angemeldet();
      // Ganze Liste: nur mit Login – und ohne ID-Bedingung, sonst scheitert sie
      allow list: if angemeldet();
      allow write: if angemeldet();
    }

    // Zugangsdaten zu Fremdsystemen (Dokument 'fastbill': E-Mail, API-Key,
    // Proxy-URL). Bewusst NICHT in settings: dort hätte der Schlüssel entweder
    // die Listen-Abfrage blockiert oder für jeden Monteur offen gelegen.
    // BEWUSST istBuero() statt darfVerwalten(): darfVerwalten() schliesst die
    // Uebergangsregel keinRollenmodell() ein, die JEDEN angemeldeten Zugang ohne
    // eigenes users-Dokument als Verwaltung durchgehen laesst. Fuer die
    // uebrigen Sammlungen ist das vertretbar – hier liegt der FastBill-API-
    // Schluessel, das Empfindlichste im ganzen Bestand. Ein versehentlich in der
    // Firebase-Konsole angelegtes Konto ohne Profil darf ihn nicht lesen.
    // Folge: Wer hier "Missing or insufficient permissions" sieht, hat kein
    // users-Dokument mit rolle 'admin' unter seiner Auth-UID.
    match /integrationen/{id} {
      allow read, write: if istBuero();
    }

    // Leistungsmeldungen: das Tagesprotokoll der gemeldeten Mengen.
    //
    // Anlegen darf jeder Angemeldete, ABER nur unter eigenem Namen: die
    // mitarbeiterId muss die eigene Auth-UID sein. Sonst könnte eine Meldung
    // einem Kollegen untergeschoben werden – und diese Zeilen sind gegenüber
    // dem Generalunternehmer Nachweis.
    //
    // Ändern darf ein Monteur NICHTS an einer bestehenden Zeile außer dem
    // Stornieren der eigenen. Eine nachträglich veränderbare Mengenmeldung wäre
    // als Beweismittel wertlos; Korrekturen laufen deshalb über eine NEUE Zeile
    // mit der Differenz, nicht über das Überschreiben der alten.
    //
    // Gelöscht wird nie – auch nicht vom Büro. Storniert bleibt sichtbar.
    // Raeume einer Baustelle. Der Monteur darf vor Ort fehlende Raeume ANLEGEN –
    // das Buero kennt die Raumnamen einer fremden Baustelle oft nicht, er steht
    // davor. Umbenennen und Deaktivieren bleibt beim Buero: sonst wandern
    // Raumnamen nachtraeglich durch den Nachweis fuer den Generalunternehmer.
    match /raeume/{id} {
      allow read: if angemeldet();
      allow create: if darfVerwalten() || istMonteur();
      allow update: if darfVerwalten()
        // 'status' traegt den Zustand JE FLAECHE (Decke, Nordwand, ...). Der
        // Monteur meldet damit, was er fertig hat – auch nur eine Wand.
        // 'aufgaben' MUSS dabei sein: Der Monteur hakt im Raumfenster die
        // Arbeitsschritte ab, und das schreibt genau dieses Feld. Ohne den
        // Schluessel scheitert jedes Abhaken mit PERMISSION_DENIED – der
        // Kernablauf auf der Baustelle waere tot.
        // Bewusst in Kauf genommen: der Monteur koennte ueber dieses Feld auch
        // Aufgaben entfernen. Die Oberflaeche bietet es ihm nicht an, und die
        // schutzbeduerftigen Daten (Berichte, Rechnungen, Preise) liegen
        // woanders und bleiben gesperrt.
        || (istMonteur() && nurFelder(['fertig', 'notiz', 'status', 'aufgaben']));
      allow delete: if darfVerwalten();
    }

    // Sollmengen je Raum und LV-Position. Sie entstehen aus der Verteilung im
    // Buero und sind abrechnungsrelevant – der Monteur liest sie nur.
    match /raumsoll/{id} {
      allow read: if angemeldet();
      allow write: if darfVerwalten();
    }

    match /leistungen/{id} {
      allow read: if angemeldet();
      allow create: if darfVerwalten()
        || (istMonteur() && request.resource.data.mitarbeiterId == request.auth.uid);
      allow update: if darfVerwalten()
        || (istMonteur()
            && resource.data.mitarbeiterId == request.auth.uid
            && nurFelder(['storniert', 'storniertAm', 'storniertVon']));
      // Löschen NUR dem Büro erlaubt, und die Oberfläche bietet es nirgends an –
      // korrigiert wird ausschließlich über Storno. Ganz verbieten geht aber
      // nicht: das Zurücksetzen der Beispieldaten (store.resetDemo) und das
      // Löschen eines Projekts samt Anhängen (Projekte.jsx, ANHAENGE) räumen
      // alle Sammlungen der Reihe nach ab. Mit "if false" wäre der ganze
      // Vorgang gescheitert – genau daran ist die Erstbefüllung schon einmal
      // zerbrochen, als 'plaene' und 'feedback' keine Regel hatten.
      // darfVerwalten() statt istBuero(), damit es sich wie lvpositionen und die
      // übrigen Sammlungen verhält: sonst scheitert die Erstbefüllung einer
      // frischen Datenbank, in der es noch kein users-Dokument gibt.
      allow delete: if darfVerwalten();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
