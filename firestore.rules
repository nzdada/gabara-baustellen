rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Anfragen von der öffentlichen Gabara-Webseite:
    // Jeder darf ANLEGEN (Formular), aber niemand ohne Login darf lesen/ändern.
    match /requests/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'telefon', 'email', 'anliegen', 'anliegenId', 'nachricht', 'sprache', 'status', 'createdAt'])
                    && request.resource.data.keys().hasAll(['name', 'anliegen', 'status'])
                    && request.resource.data.status == 'neu'
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 1
                    && request.resource.data.name.size() < 120
                    && request.resource.data.nachricht.size() < 3000;
      allow read, update, delete: if request.auth != null;
    }

    // Interne Kern-Daten: nur mit Login (Gabara-Team).
    // Rollen-Feinschnitt (admin vs. mitarbeiter) folgt beim Firebase-Go-Live.
    match /patients/{id} { allow read, write: if request.auth != null; }
    match /appointments/{id} { allow read, write: if request.auth != null; }
    match /projekte/{id} { allow read, write: if request.auth != null; }
    match /lvpositionen/{id} { allow read, write: if request.auth != null; }
    match /berichte/{id} { allow read, write: if request.auth != null; }
    match /spesen/{id} { allow read, write: if request.auth != null; }
    match /photos/{id} {
      allow read, write: if request.auth != null
        && (!('dataUrl' in request.resource.data) || request.resource.data.dataUrl.size() < 980000);
    }
    match /rechnungen/{id} { allow read, write: if request.auth != null; }
    match /apilog/{id} { allow read, write: if request.auth != null; }
    match /users/{id} { allow read, write: if request.auth != null; }
    match /katalog/{id} { allow read, write: if request.auth != null; }
    match /bausteine/{id} { allow read, write: if request.auth != null; }

    match /settings/{id} {
      // Nur reine Zeit-Dokumente öffentlich lesbar (falls die Webseite sie je braucht);
      // alles andere (global, integrationen mit FastBill-Zugang!) bleibt Team-intern.
      allow read: if id in ['pausen', 'oeffnungszeiten'] || request.auth != null;
      allow write: if request.auth != null;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
